
    {{-- ========================================================= --}}
    {{-- HEADER --}}
    {{-- ========================================================= --}}

    <x-slot name="header">
        <div>
            <h2 class="text-xl font-bold text-gray-900">
                Pembayaran
            </h2>

            <p class="mt-1 text-sm text-gray-500">
                Kelola pembayaran dan status tagihan rental
            </p>
        </div>
    </x-slot>


    {{-- ========================================================= --}}
    {{-- CONTENT --}}
    {{-- ========================================================= --}}

    <div class="min-h-[calc(100vh-64px)] bg-gray-50 px-4 py-6 sm:px-6 lg:px-8">

        <div class="mx-auto max-w-7xl">


            {{-- ================================================= --}}
            {{-- SEARCH CARD --}}
            {{-- ================================================= --}}

            <div class="mb-6 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">

                <div class="max-w-xl">

                    <label
                        for="searchInput"
                        class="mb-2 block text-sm font-semibold text-gray-700">

                        Cari Rental

                    </label>

                    <div class="relative">

                        {{-- Search Icon --}}
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 text-gray-400"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="1.8">

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0z" />

                            </svg>

                        </div>

                        <input
                            type="text"
                            id="searchInput"
                            class="w-full rounded-xl border border-gray-200 bg-gray-50 py-2.5 pl-10 pr-4 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-900 focus:bg-white focus:ring-2 focus:ring-gray-900/10"
                            placeholder="Kode rental / nama pelanggan / ID pelanggan...">

                    </div>

                </div>

            </div>


            {{-- ================================================= --}}
            {{-- TABLE CARD --}}
            {{-- ================================================= --}}

            <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

                {{-- Card Header --}}

                <div class="border-b border-gray-100 px-5 py-4">

                    <div class="flex items-center justify-between gap-4">

                        <div>

                            <h3 class="text-base font-bold text-gray-900">
                                Daftar Pembayaran
                            </h3>

                            <p class="mt-1 text-xs text-gray-500">
                                Pantau tagihan dan pembayaran setiap rental
                            </p>

                        </div>

                        <div
                            id="totalRentalLabel"
                            class="rounded-lg bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-600">

                            0 Rental

                        </div>

                    </div>

                </div>


                {{-- Table --}}

                <div class="overflow-x-auto">

                    <table class="min-w-full divide-y divide-gray-100">

                        <thead class="bg-gray-50">

                            <tr>

                                <th class="whitespace-nowrap px-5 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                    No
                                </th>

                                <th class="whitespace-nowrap px-5 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Kode Rental
                                </th>

                                <th class="whitespace-nowrap px-5 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Pelanggan
                                </th>

                                <th class="whitespace-nowrap px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Total
                                </th>

                                <th class="whitespace-nowrap px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Dibayar
                                </th>

                                <th class="whitespace-nowrap px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Sisa
                                </th>

                                <th class="whitespace-nowrap px-5 py-3 text-center text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Status
                                </th>

                                <th class="whitespace-nowrap px-5 py-3 text-center text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Aksi
                                </th>

                            </tr>

                        </thead>


                        <tbody
                            id="paymentTableBody"
                            class="divide-y divide-gray-100 bg-white">

                            <tr>

                                <td
                                    colspan="8"
                                    class="px-5 py-12 text-center">

                                    <div class="flex flex-col items-center">

                                        <svg
                                            class="mb-3 h-8 w-8 animate-spin text-gray-400"
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24">

                                            <circle
                                                class="opacity-25"
                                                cx="12"
                                                cy="12"
                                                r="10"
                                                stroke="currentColor"
                                                stroke-width="4">
                                            </circle>

                                            <path
                                                class="opacity-75"
                                                fill="currentColor"
                                                d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z">
                                            </path>

                                        </svg>

                                        <span class="text-sm text-gray-500">
                                            Memuat data...
                                        </span>

                                    </div>

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


                {{-- Pagination --}}

                <div
                    id="paginationContainer"
                    class="border-t border-gray-100 px-5 py-4">
                </div>

            </div>

        </div>

    </div>


    {{-- ========================================================= --}}
    {{-- PAYMENT MODAL --}}
    {{-- ========================================================= --}}

    <div
        id="paymentModal"
        class="fixed inset-0 z-[100] hidden">

        {{-- Overlay --}}

        <div
            id="paymentModalOverlay"
            class="absolute inset-0 bg-gray-900/50 backdrop-blur-sm">
        </div>


        {{-- Modal Wrapper --}}

        <div class="relative flex min-h-full items-center justify-center p-4">

            <div
                class="relative w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl">

                {{-- Modal Header --}}

                <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4">

                    <div>

                        <h3 class="text-lg font-bold text-gray-900">
                            Tambah Pembayaran
                        </h3>

                        <p class="mt-1 text-xs text-gray-500">
                            Masukkan detail pembayaran rental
                        </p>

                    </div>


                    <button
                        type="button"
                        id="closePaymentModal"
                        class="rounded-lg p-2 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.8">

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M6 18 18 6M6 6l12 12" />

                        </svg>

                    </button>

                </div>


                {{-- Modal Body --}}

                <div class="max-h-[75vh] overflow-y-auto px-6 py-5">

                    <form id="paymentForm">

                        <input
                            type="hidden"
                            id="rental_id"
                            name="rental_id">


                        {{-- Rental Summary --}}

                        <div class="mb-5 rounded-xl border border-gray-200 bg-gray-50 p-4">

                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">

                                <div>

                                    <p class="text-xs font-medium text-gray-500">
                                        Kode Rental
                                    </p>

                                    <p
                                        id="modalRentalCode"
                                        class="mt-1 text-sm font-bold text-gray-900">
                                        -
                                    </p>

                                </div>


                                <div>

                                    <p class="text-xs font-medium text-gray-500">
                                        Pelanggan
                                    </p>

                                    <p
                                        id="modalCustomer"
                                        class="mt-1 text-sm font-bold text-gray-900">
                                        -
                                    </p>

                                </div>


                                <div>

                                    <p class="text-xs font-medium text-gray-500">
                                        Sisa Tagihan
                                    </p>

                                    <p
                                        id="modalRemaining"
                                        class="mt-1 text-sm font-bold text-red-600">
                                        Rp 0
                                    </p>

                                </div>

                            </div>

                        </div>


                        {{-- Tanggal Pembayaran --}}

                        <div class="mb-4">

                            <label
                                for="paid_at"
                                class="mb-2 block text-sm font-semibold text-gray-700">

                                Tanggal Pembayaran

                            </label>

                            <input
                                type="datetime-local"
                                id="paid_at"
                                name="paid_at"
                                required
                                class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10">

                        </div>


                        {{-- Jumlah --}}

                        <div class="mb-4">

                            <label
                                for="amount"
                                class="mb-2 block text-sm font-semibold text-gray-700">

                                Jumlah Pembayaran

                            </label>

                            <div class="relative">

                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-sm font-medium text-gray-500">
                                    Rp
                                </span>

                                <input
                                    type="number"
                                    id="amount"
                                    name="amount"
                                    min="0.01"
                                    step="0.01"
                                    required
                                    class="w-full rounded-xl border border-gray-200 bg-white py-2.5 pl-11 pr-4 text-sm text-gray-900 outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10"
                                    placeholder="0">

                            </div>

                            <p class="mt-1.5 text-xs text-gray-500">
                                Jumlah tidak boleh melebihi sisa tagihan.
                            </p>

                        </div>


                        {{-- Metode --}}

                        <div class="mb-4">

                            <label
                                for="method"
                                class="mb-2 block text-sm font-semibold text-gray-700">

                                Metode Pembayaran

                            </label>

                            <select
                                id="method"
                                name="method"
                                required
                                class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10">

                                <option value="">
                                    Pilih metode pembayaran
                                </option>

                                <option value="cash">
                                    Cash
                                </option>

                                <option value="transfer">
                                    Transfer
                                </option>

                                <option value="qris">
                                    QRIS
                                </option>

                                <option value="debit">
                                    Debit
                                </option>

                                <option value="e_wallet">
                                    E-Wallet
                                </option>

                            </select>

                        </div>


                        {{-- Catatan --}}

                        <div class="mb-4">

                            <label
                                for="notes"
                                class="mb-2 block text-sm font-semibold text-gray-700">

                                Catatan

                            </label>

                            <textarea
                                id="notes"
                                name="notes"
                                rows="3"
                                class="w-full resize-none rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10"
                                placeholder="Catatan pembayaran (opsional)"></textarea>

                        </div>


                        {{-- Error --}}

                        <div
                            id="paymentError"
                            class="mb-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                        </div>

                    </form>

                </div>


                {{-- Modal Footer --}}

                <div class="flex items-center justify-end gap-3 border-t border-gray-100 bg-gray-50 px-6 py-4">

                    <button
                        type="button"
                        id="cancelPaymentBtn"
                        class="rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-100">

                        Batal

                    </button>


                    <button
                        type="button"
                        id="savePaymentBtn"
                        class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-gray-800 disabled:cursor-not-allowed disabled:opacity-50">

                        Simpan Pembayaran

                    </button>

                </div>

            </div>

        </div>

    </div>


    {{-- ========================================================= --}}
    {{-- HISTORY MODAL --}}
    {{-- ========================================================= --}}

    <div
        id="historyModal"
        class="fixed inset-0 z-[100] hidden">

        {{-- Overlay --}}

        <div
            id="historyModalOverlay"
            class="absolute inset-0 bg-gray-900/50 backdrop-blur-sm">
        </div>


        <div class="relative flex min-h-full items-center justify-center p-4">

            <div
                class="relative w-full max-w-4xl overflow-hidden rounded-2xl bg-white shadow-2xl">

                {{-- Header --}}

                <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4">

                    <div>

                        <h3 class="text-lg font-bold text-gray-900">
                            Riwayat Pembayaran
                        </h3>

                        <p class="mt-1 text-xs text-gray-500">
                            Detail seluruh pembayaran rental
                        </p>

                    </div>


                    <button
                        type="button"
                        id="closeHistoryModal"
                        class="rounded-lg p-2 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.8">

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M6 18 18 6M6 6l12 12" />

                        </svg>

                    </button>

                </div>


                {{-- Content --}}

                <div
                    id="historyContent"
                    class="max-h-[70vh] overflow-y-auto px-6 py-5">

                    <div class="py-10 text-center text-sm text-gray-500">
                        Memuat...
                    </div>

                </div>

            </div>

        </div>

    </div>


    {{-- ========================================================= --}}
    {{-- TOAST --}}
    {{-- ========================================================= --}}

    <div
        id="toast"
        class="fixed right-5 top-5 z-[200] hidden max-w-sm rounded-xl px-4 py-3 text-sm font-medium shadow-lg">

    </div>


    {{-- ========================================================= --}}
    {{-- JAVASCRIPT --}}
    {{-- ========================================================= --}}

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            // ====================================================
            // ELEMENTS
            // ====================================================

            const tableBody =
                document.getElementById('paymentTableBody');

            const paginationContainer =
                document.getElementById('paginationContainer');

            const searchInput =
                document.getElementById('searchInput');

            const totalRentalLabel =
                document.getElementById('totalRentalLabel');

            const paymentModal =
                document.getElementById('paymentModal');

            const historyModal =
                document.getElementById('historyModal');

            const paymentForm =
                document.getElementById('paymentForm');

            const paymentError =
                document.getElementById('paymentError');

            const csrfToken =
                document.querySelector('meta[name="csrf-token"]')
                    .getAttribute('content');


            let currentPage = 1;

            let searchTimeout = null;


            // ====================================================
            // RUPIAH
            // ====================================================

            function formatRupiah(number) {

                return 'Rp ' +
                    Number(number || 0)
                        .toLocaleString('id-ID');

            }


            // ====================================================
            // DATE
            // ====================================================

            function formatDate(dateString) {

                if (!dateString) {
                    return '-';
                }

                const date =
                    new Date(dateString);

                return date.toLocaleString('id-ID', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

            }


            // ====================================================
            // METHOD
            // ====================================================

            function formatMethod(method) {

                const methods = {
                    cash: 'Cash',
                    transfer: 'Transfer',
                    qris: 'QRIS',
                    debit: 'Debit',
                    e_wallet: 'E-Wallet'
                };

                return methods[method] || method || '-';

            }


            // ====================================================
            // HTML ESCAPE
            // ====================================================

            function escapeHtml(value) {

                if (value === null || value === undefined) {
                    return '';
                }

                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');

            }


            // ====================================================
            // STATUS BADGE
            // ====================================================

            function statusBadge(status) {

                if (status === 'paid') {

                    return `
                        <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-1 text-xs font-bold text-green-700 ring-1 ring-inset ring-green-600/20">
                            PAID
                        </span>
                    `;

                }


                if (status === 'partial') {

                    return `
                        <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700 ring-1 ring-inset ring-amber-600/20">
                            PARTIAL
                        </span>
                    `;

                }


                return `
                    <span class="inline-flex items-center rounded-full bg-red-50 px-2.5 py-1 text-xs font-bold text-red-700 ring-1 ring-inset ring-red-600/20">
                        UNPAID
                    </span>
                `;

            }


            // ====================================================
            // TOAST
            // ====================================================

            function showToast(message, type = 'success') {

                const toast =
                    document.getElementById('toast');

                toast.textContent = message;

                toast.className =
                    'fixed right-5 top-5 z-[200] max-w-sm rounded-xl px-4 py-3 text-sm font-medium shadow-lg';

                if (type === 'success') {

                    toast.classList.add(
                        'bg-gray-900',
                        'text-white'
                    );

                } else {

                    toast.classList.add(
                        'bg-red-600',
                        'text-white'
                    );

                }

                toast.classList.remove('hidden');

                setTimeout(() => {

                    toast.classList.add('hidden');

                }, 3000);

            }


            // ====================================================
            // LOAD PAYMENTS
            // ====================================================

            function loadPayments(page = 1) {

                currentPage = page;

                tableBody.innerHTML = `

                    <tr>

                        <td
                            colspan="8"
                            class="px-5 py-12 text-center">

                            <div class="flex flex-col items-center">

                                <svg
                                    class="mb-3 h-8 w-8 animate-spin text-gray-400"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24">

                                    <circle
                                        class="opacity-25"
                                        cx="12"
                                        cy="12"
                                        r="10"
                                        stroke="currentColor"
                                        stroke-width="4">
                                    </circle>

                                    <path
                                        class="opacity-75"
                                        fill="currentColor"
                                        d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z">
                                    </path>

                                </svg>

                                <span class="text-sm text-gray-500">
                                    Memuat data...
                                </span>

                            </div>

                        </td>

                    </tr>

                `;


                const params =
                    new URLSearchParams();

                params.append('page', page);


                if (searchInput.value.trim() !== '') {

                    params.append(
                        'search',
                        searchInput.value.trim()
                    );

                }


                fetch(
                    `{{ route('payments.index') }}?${params.toString()}`,
                    {
                        method: 'GET',

                        headers: {
                            'X-Requested-With':
                                'XMLHttpRequest',

                            'Accept':
                                'application/json'
                        }
                    }
                )

                .then(async response => {

                    const data =
                        await response.json();

                    if (!response.ok) {

                        throw new Error(
                            data.message ||
                            'Gagal mengambil data pembayaran.'
                        );

                    }

                    return data;

                })

                .then(data => {

                    renderTable(data);

                    renderPagination(data);

                    totalRentalLabel.textContent =
                        `${data.total || 0} Rental`;

                })

                .catch(error => {

                    console.error(error);

                    tableBody.innerHTML = `

                        <tr>

                            <td
                                colspan="8"
                                class="px-5 py-12 text-center">

                                <div class="mx-auto max-w-md">

                                    <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-red-50 text-red-600">

                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-5 w-5"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="1.8">

                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M12 9v4m0 4h.01M10.3 4.2l-7 12.1A2 2 0 005 19h14a2 2 0 001.7-2.7l-7-12.1a2 2 0 00-3.4 0z" />

                                        </svg>

                                    </div>

                                    <p class="text-sm font-semibold text-gray-900">
                                        Gagal memuat data
                                    </p>

                                    <p class="mt-1 text-xs text-red-500">
                                        ${escapeHtml(error.message)}
                                    </p>

                                </div>

                            </td>

                        </tr>

                    `;

                });

            }


            // ====================================================
            // RENDER TABLE
            // ====================================================

            function renderTable(response) {

                const data =
                    response.data || [];


                if (data.length === 0) {

                    tableBody.innerHTML = `

                        <tr>

                            <td
                                colspan="8"
                                class="px-5 py-12 text-center">

                                <div class="flex flex-col items-center">

                                    <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100">

                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-6 w-6 text-gray-400"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="1.8">

                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M12 6v12m6-6H6" />

                                        </svg>

                                    </div>

                                    <p class="text-sm font-semibold text-gray-700">
                                        Belum ada data rental
                                    </p>

                                    <p class="mt-1 text-xs text-gray-400">
                                        Data rental akan muncul di sini.
                                    </p>

                                </div>

                            </td>

                        </tr>

                    `;

                    return;

                }


                let html = '';


                data.forEach((rental, index) => {

                    const number =
                        ((response.current_page - 1) * 10)
                        + index + 1;


                    const rentalJson =
                        JSON.stringify(rental)
                            .replace(/'/g, '&#039;');


                    const rentalCode =
                        escapeHtml(rental.rental_code);

                    const customer =
                        escapeHtml(rental.customer || '-');


                    html += `

                        <tr class="transition hover:bg-gray-50">

                            <td class="whitespace-nowrap px-5 py-4 text-sm text-gray-500">
                                ${number}
                            </td>


                            <td class="whitespace-nowrap px-5 py-4">

                                <span class="font-semibold text-gray-900">
                                    ${rentalCode}
                                </span>

                            </td>


                            <td class="whitespace-nowrap px-5 py-4">

                                <div class="text-sm font-medium text-gray-900">
                                    ${customer}
                                </div>

                            </td>


                            <td class="whitespace-nowrap px-5 py-4 text-right text-sm font-semibold text-gray-900">
                                ${formatRupiah(rental.total)}
                            </td>


                            <td class="whitespace-nowrap px-5 py-4 text-right text-sm font-semibold text-green-600">
                                ${formatRupiah(rental.paid)}
                            </td>


                            <td class="whitespace-nowrap px-5 py-4 text-right text-sm font-semibold text-red-600">
                                ${formatRupiah(rental.remaining)}
                            </td>


                            <td class="whitespace-nowrap px-5 py-4 text-center">
                                ${statusBadge(rental.status)}
                            </td>


                            <td class="whitespace-nowrap px-5 py-4">

                                <div class="flex items-center justify-center gap-2">

                                    ${
                                        Number(rental.remaining) > 0
                                        ?

                                        `
                                            <button
                                                type="button"
                                                onclick='openPaymentModal(${rentalJson})'
                                                class="inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-3 py-2 text-xs font-semibold text-white transition hover:bg-gray-800">

                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-4 w-4"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                    stroke-width="1.8">

                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        d="M12 6v12m6-6H6" />

                                                </svg>

                                                Bayar

                                            </button>
                                        `

                                        :

                                        ''
                                    }


                                    <button
                                        type="button"
                                        onclick='showHistory(${JSON.stringify(rental.payments || [])}, ${JSON.stringify(rental.rental_code)})'
                                        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50">

                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-4 w-4"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="1.8">

                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M9 5h6m-7 4h8m-8 4h8m-8 4h5M7 3h10a2 2 0 012 2v14a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z" />

                                        </svg>

                                        Riwayat

                                    </button>

                                </div>

                            </td>

                        </tr>

                    `;

                });


                tableBody.innerHTML = html;

            }


            // ====================================================
            // PAGINATION
            // ====================================================

            function renderPagination(response) {

                const current =
                    response.current_page || 1;

                const last =
                    response.last_page || 1;


                if (last <= 1) {

                    paginationContainer.innerHTML = '';

                    return;

                }


                let html = `

                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

                        <p class="text-xs text-gray-500">
                            Halaman ${current} dari ${last}
                        </p>

                        <div class="flex items-center gap-1">

                `;


                if (current > 1) {

                    html += `

                        <button
                            type="button"
                            onclick="loadPayments(${current - 1})"
                            class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-600 transition hover:bg-gray-50">

                            Sebelumnya

                        </button>

                    `;

                }


                for (
                    let page = 1;
                    page <= last;
                    page++
                ) {

                    if (
                        page === 1 ||
                        page === last ||
                        Math.abs(page - current) <= 1
                    ) {

                        html += `

                            <button
                                type="button"
                                onclick="loadPayments(${page})"
                                class="min-w-[36px] rounded-lg px-3 py-2 text-xs font-semibold transition ${
                                    page === current
                                    ? 'bg-gray-900 text-white'
                                    : 'border border-gray-200 bg-white text-gray-600 hover:bg-gray-50'
                                }">

                                ${page}

                            </button>

                        `;

                    } else if (
                        page === current - 2 ||
                        page === current + 2
                    ) {

                        html += `
                            <span class="px-1 text-gray-400">
                                ...
                            </span>
                        `;

                    }

                }


                if (current < last) {

                    html += `

                        <button
                            type="button"
                            onclick="loadPayments(${current + 1})"
                            class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-600 transition hover:bg-gray-50">

                            Berikutnya

                        </button>

                    `;

                }


                html += `

                        </div>

                    </div>

                `;


                paginationContainer.innerHTML =
                    html;

            }


            // ====================================================
            // OPEN PAYMENT MODAL
            // ====================================================

            window.openPaymentModal =
                function (rental) {

                    paymentForm.reset();

                    paymentError.classList.add(
                        'hidden'
                    );

                    paymentError.innerHTML = '';


                    document.getElementById(
                        'rental_id'
                    ).value =
                        rental.id;


                    document.getElementById(
                        'modalRentalCode'
                    ).textContent =
                        rental.rental_code || '-';


                    document.getElementById(
                        'modalCustomer'
                    ).textContent =
                        rental.customer || '-';


                    document.getElementById(
                        'modalRemaining'
                    ).textContent =
                        formatRupiah(
                            rental.remaining
                        );


                    document.getElementById(
                        'amount'
                    ).value =
                        Number(
                            rental.remaining || 0
                        );


                    document.getElementById(
                        'amount'
                    ).max =
                        Number(
                            rental.remaining || 0
                        );


                    // Current local date/time

                    const now =
                        new Date();

                    const localDateTime =
                        now.getFullYear() +
                        '-' +
                        String(
                            now.getMonth() + 1
                        ).padStart(2, '0') +
                        '-' +
                        String(
                            now.getDate()
                        ).padStart(2, '0') +
                        'T' +
                        String(
                            now.getHours()
                        ).padStart(2, '0') +
                        ':' +
                        String(
                            now.getMinutes()
                        ).padStart(2, '0');


                    document.getElementById(
                        'paid_at'
                    ).value =
                        localDateTime;


                    paymentModal.classList.remove(
                        'hidden'
                    );

                    document.body.classList.add(
                        'overflow-hidden'
                    );

                };


            // ====================================================
            // CLOSE PAYMENT MODAL
            // ====================================================

            function closePaymentModal() {

                paymentModal.classList.add(
                    'hidden'
                );

                document.body.classList.remove(
                    'overflow-hidden'
                );

            }


            document.getElementById(
                'closePaymentModal'
            ).addEventListener(
                'click',
                closePaymentModal
            );


            document.getElementById(
                'cancelPaymentBtn'
            ).addEventListener(
                'click',
                closePaymentModal
            );


            document.getElementById(
                'paymentModalOverlay'
            ).addEventListener(
                'click',
                closePaymentModal
            );


            // ====================================================
            // SAVE PAYMENT
            // ====================================================

            document.getElementById(
                'savePaymentBtn'
            ).addEventListener(
                'click',
                function () {

                    const button = this;

                    const formData =
                        new FormData(
                            paymentForm
                        );


                    paymentError.classList.add(
                        'hidden'
                    );

                    paymentError.innerHTML =
                        '';


                    button.disabled = true;

                    button.innerHTML = `

                        <span class="inline-flex items-center gap-2">

                            <svg
                                class="h-4 w-4 animate-spin"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24">

                                <circle
                                    class="opacity-25"
                                    cx="12"
                                    cy="12"
                                    r="10"
                                    stroke="currentColor"
                                    stroke-width="4">
                                </circle>

                                <path
                                    class="opacity-75"
                                    fill="currentColor"
                                    d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z">
                                </path>

                            </svg>

                            Menyimpan...

                        </span>

                    `;


                    fetch(
                        `{{ route('payments.store') }}`,
                        {

                            method: 'POST',

                            headers: {

                                'X-CSRF-TOKEN':
                                    csrfToken,

                                'X-Requested-With':
                                    'XMLHttpRequest',

                                'Accept':
                                    'application/json'

                            },

                            body: formData

                        }
                    )

                    .then(async response => {

                        const data =
                            await response.json();


                        if (!response.ok) {

                            let message =
                                data.message ||
                                'Pembayaran gagal disimpan.';


                            if (data.errors) {

                                message =
                                    Object.values(
                                        data.errors
                                    )
                                    .flat()
                                    .join('<br>');

                            }


                            throw new Error(
                                message
                            );

                        }


                        return data;

                    })

                    .then(data => {

                        closePaymentModal();

                        showToast(
                            data.message ||
                            'Pembayaran berhasil disimpan.',
                            'success'
                        );

                        loadPayments(
                            currentPage
                        );

                    })

                    .catch(error => {

                        paymentError.innerHTML =
                            error.message;

                        paymentError.classList.remove(
                            'hidden'
                        );

                    })

                    .finally(() => {

                        button.disabled =
                            false;

                        button.innerHTML =
                            'Simpan Pembayaran';

                    });

                }
            );


            // ====================================================
            // SHOW HISTORY
            // ====================================================

            window.showHistory =
                function (
                    payments,
                    rentalCode
                ) {

                    const historyContent =
                        document.getElementById(
                            'historyContent'
                        );


                    if (
                        !payments ||
                        payments.length === 0
                    ) {

                        historyContent.innerHTML = `

                            <div class="py-12 text-center">

                                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100">

                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-6 w-6 text-gray-400"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="1.8">

                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M12 6v12m6-6H6" />

                                    </svg>

                                </div>

                                <p class="text-sm font-semibold text-gray-700">
                                    Belum ada pembayaran
                                </p>

                                <p class="mt-1 text-xs text-gray-400">
                                    Rental ${escapeHtml(rentalCode)}
                                    belum memiliki pembayaran.
                                </p>

                            </div>

                        `;

                    } else {

                        let html = `

                            <div class="mb-4 rounded-xl bg-gray-50 px-4 py-3">

                                <p class="text-xs text-gray-500">
                                    Kode Rental
                                </p>

                                <p class="mt-1 text-sm font-bold text-gray-900">
                                    ${escapeHtml(rentalCode)}
                                </p>

                            </div>


                            <div class="overflow-x-auto">

                                <table class="min-w-full divide-y divide-gray-100">

                                    <thead class="bg-gray-50">

                                        <tr>

                                            <th class="whitespace-nowrap px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                                Kode
                                            </th>

                                            <th class="whitespace-nowrap px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                                Tanggal
                                            </th>

                                            <th class="whitespace-nowrap px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                                Metode
                                            </th>

                                            <th class="whitespace-nowrap px-4 py-3 text-right text-xs font-bold uppercase tracking-wider text-gray-500">
                                                Jumlah
                                            </th>

                                            <th class="whitespace-nowrap px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                                Catatan
                                            </th>

                                            <th class="whitespace-nowrap px-4 py-3 text-center text-xs font-bold uppercase tracking-wider text-gray-500">
                                                Aksi
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody class="divide-y divide-gray-100 bg-white">

                        `;


                        payments.forEach(
                            payment => {

                                html += `

                                    <tr class="hover:bg-gray-50">

                                        <td class="whitespace-nowrap px-4 py-3 text-sm font-semibold text-gray-900">
                                            ${escapeHtml(payment.payment_code)}
                                        </td>

                                        <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-600">
                                            ${formatDate(payment.paid_at)}
                                        </td>

                                        <td class="whitespace-nowrap px-4 py-3">

                                            <span class="inline-flex rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700">
                                                ${formatMethod(payment.method)}
                                            </span>

                                        </td>

                                        <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-bold text-green-600">
                                            ${formatRupiah(payment.amount)}
                                        </td>

                                        <td class="max-w-[220px] px-4 py-3 text-sm text-gray-600">
                                            ${escapeHtml(payment.notes || '-')}
                                        </td>

                                        <td class="whitespace-nowrap px-4 py-3 text-center">

                                            <button
                                                type="button"
                                                onclick="deletePayment(${payment.id})"
                                                class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50">

                                                Hapus

                                            </button>

                                        </td>

                                    </tr>

                                `;

                            }
                        );


                        html += `

                                    </tbody>

                                </table>

                            </div>

                        `;


                        historyContent.innerHTML =
                            html;

                    }


                    historyModal.classList.remove(
                        'hidden'
                    );

                    document.body.classList.add(
                        'overflow-hidden'
                    );

                };


            // ====================================================
            // CLOSE HISTORY
            // ====================================================

            function closeHistoryModal() {

                historyModal.classList.add(
                    'hidden'
                );

                document.body.classList.remove(
                    'overflow-hidden'
                );

            }


            document.getElementById(
                'closeHistoryModal'
            ).addEventListener(
                'click',
                closeHistoryModal
            );


            document.getElementById(
                'historyModalOverlay'
            ).addEventListener(
                'click',
                closeHistoryModal
            );


            // ====================================================
            // DELETE PAYMENT
            // ====================================================

            window.deletePayment =
                function (paymentId) {

                    const confirmed =
                        confirm(
                            'Yakin ingin menghapus pembayaran ini?'
                        );


                    if (!confirmed) {
                        return;
                    }


                    fetch(
                        `{{ url('/payments') }}/${paymentId}`,
                        {

                            method: 'DELETE',

                            headers: {

                                'X-CSRF-TOKEN':
                                    csrfToken,

                                'X-Requested-With':
                                    'XMLHttpRequest',

                                'Accept':
                                    'application/json'

                            }

                        }
                    )

                    .then(async response => {

                        const data =
                            await response.json();


                        if (!response.ok) {

                            throw new Error(
                                data.message ||
                                'Gagal menghapus pembayaran.'
                            );

                        }


                        return data;

                    })

                    .then(data => {

                        closeHistoryModal();

                        showToast(
                            data.message ||
                            'Pembayaran berhasil dihapus.',
                            'success'
                        );

                        loadPayments(
                            currentPage
                        );

                    })

                    .catch(error => {

                        showToast(
                            error.message,
                            'error'
                        );

                    });

                };


            // ====================================================
            // SEARCH
            // ====================================================

            searchInput.addEventListener(
                'input',
                function () {

                    clearTimeout(
                        searchTimeout
                    );


                    searchTimeout =
                        setTimeout(
                            function () {

                                loadPayments(1);

                            },
                            400
                        );

                }
            );


            // ====================================================
            // ESCAPE KEY
            // ====================================================

            document.addEventListener(
                'keydown',
                function (event) {

                    if (
                        event.key !== 'Escape'
                    ) {
                        return;
                    }


                    if (
                        !paymentModal.classList.contains(
                            'hidden'
                        )
                    ) {

                        closePaymentModal();

                    }


                    if (
                        !historyModal.classList.contains(
                            'hidden'
                        )
                    ) {

                        closeHistoryModal();

                    }

                }
            );


            // ====================================================
            // INITIAL LOAD
            // ====================================================

            window.loadPayments =
                loadPayments;


            loadPayments(1);

        });

    </script>

